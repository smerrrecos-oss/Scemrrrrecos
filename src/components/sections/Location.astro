---
import { site } from '../../data/site';
import { withBase } from '../../utils/withBase';
---

<section id="location" class="bg-white py-16 lg:py-24">
	<div class="max-w-[1440px] mx-auto px-6 lg:px-12">
		<div class="mb-12 lg:mb-16">
			<p class="text-sm text-[#2D2926]/60 mb-2">/01</p>
			<h2 class="text-2xl lg:text-4xl font-bold text-[#2D2926] mb-6 lg:mb-8">
				{site.location.title}
			</h2>
			<p class="text-base lg:text-lg text-[#2D2926]/80 max-w-3xl leading-relaxed mb-2">
				{site.location.description}
			</p>
			{site.location.address && (
				<p class="text-base lg:text-lg font-medium text-[#2D2926] max-w-3xl">
					{site.location.address}
				</p>
			)}
		</div>
		
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
			<div>
				<h3 class="text-2xl lg:text-3xl font-bold text-[#2D2926] mb-4">
					{site.location.question}
				</h3>
				<p class="text-base lg:text-lg text-[#2D2926]/80 mb-6">
					{site.location.subtitle}
				</p>
				<div class="space-y-4">
					{site.location.options.map((option) => (
						<div class="border border-[#2D2926]/10 rounded-lg p-6 hover:border-[#2D2926]/20 transition-colors">
							<h4 class="text-lg font-semibold text-[#2D2926] mb-2">
								{option.label}
							</h4>
							<p class="text-sm lg:text-base text-[#2D2926]/70 leading-relaxed">
								{option.details}
							</p>
						</div>
					))}
				</div>
			</div>
			<div class="w-full h-[400px] lg:h-[500px] rounded-lg overflow-hidden">
				{site.location.map && (
					<img 
						src={withBase(site.location.map.src)} 
						alt={site.location.map.alt}
						class="w-full h-full object-contain object-center bg-[#F5F5F0] rounded-lg"
						loading="lazy"
						decoding="async"
					/>
				)}
			</div>
		</div>
	</div>
</section>
