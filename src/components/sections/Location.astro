---
import { site } from '../../data/site';
---

<section id="location" class="bg-white py-16 lg:py-24">
	<div class="max-w-[1440px] mx-auto px-6 lg:px-12">
		<div class="mb-12 lg:mb-16">
			<p class="text-sm text-[#2D2926]/60 mb-2">/01</p>
			<h2 class="text-2xl lg:text-4xl font-bold text-[#2D2926] mb-6 lg:mb-8">
				{site.location.title}
			</h2>
			<p class="text-base lg:text-lg text-[#2D2926]/80 max-w-3xl leading-relaxed">
				{site.location.description}
			</p>
		</div>
		
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
			<div>
				<h3 class="text-2xl lg:text-3xl font-bold text-[#2D2926] mb-4">
					{site.location.question}
				</h3>
				<p class="text-base lg:text-lg text-[#2D2926]/80 mb-6">
					{site.location.subtitle}
				</p>
				<div class="space-y-4">
					{site.location.options.map((option) => (
						<a 
							href={`#transport-${option.toLowerCase().replace(/\s/g, '-')}`}
							class="block w-full bg-[#2D2926] text-white px-6 py-4 rounded-lg hover:bg-[#2D2926]/90 transition-colors flex items-center justify-between text-sm font-medium"
						>
							{option}
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
							</svg>
						</a>
					))}
				</div>
			</div>
			<div class="w-full h-[400px] lg:h-[500px] bg-[#E8E8E0] rounded-lg">
				<!-- Image will be added here -->
			</div>
		</div>
	</div>
</section>
