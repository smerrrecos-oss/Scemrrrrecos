---
import { site } from '../../data/site';
import { withBase } from '../../utils/withBase';
---

<section id="home" class="relative min-h-[min(100svh,920px)] flex items-end">
	<div class="absolute inset-0" aria-hidden="true">
		<img
			src={withBase(site.hero.image.src)}
			alt={site.hero.image.alt}
			class="h-full w-full object-cover object-[center_42%]"
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>
		<div class="absolute inset-0 bg-gradient-to-t from-[#2D2926]/80 via-[#2D2926]/45 to-[#2D2926]/25"></div>
	</div>

	<div class="relative z-10 w-full max-w-[1440px] mx-auto px-6 lg:px-12 pb-12 lg:pb-20 pt-28 lg:pt-36">
		<h1 class="hero-headline font-bold text-white mb-6 lg:mb-8 max-w-[min(100%,64rem)]">
			{site.hero.headline}
		</h1>
		<p class="text-base lg:text-lg text-white/85 mb-8 lg:mb-12 leading-relaxed max-w-2xl">
			{site.hero.description}
		</p>
		<div class="flex flex-col sm:flex-row gap-4 mb-6">
			<a
				href="#types"
				class="inline-flex items-center gap-2 bg-white text-[#2D2926] px-8 py-4 rounded-lg hover:bg-white/90 transition-colors text-sm font-medium uppercase"
			>
				{site.hero.cta}
				<span class="w-5 h-5 bg-[#2D2926]/10 rounded flex items-center justify-center">
					<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
					</svg>
				</span>
			</a>
		</div>
		{site.hero.trustLine && (
			<p class="text-sm text-white/70">
				{site.hero.trustLine}
			</p>
		)}
	</div>
</section>
