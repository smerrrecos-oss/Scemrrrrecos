---
import { site } from '../../data/site';
import { withBase } from '../../utils/withBase';
---

<section id="types" class="bg-[#F5F5F0] py-16 lg:py-24">
	<div class="max-w-[1440px] mx-auto px-6 lg:px-12">
		<div class="mb-12 lg:mb-16">
			<p class="text-sm text-[#2D2926]/60 mb-2">/01</p>
			<h2 class="text-2xl lg:text-4xl font-bold text-[#2D2926] mb-6 lg:mb-8">
				{site.houseTypes.title}
			</h2>
			<p class="text-base lg:text-lg text-[#2D2926]/80 max-w-3xl leading-relaxed">
				{site.houseTypes.intro}
			</p>
		</div>
		
		<div class="space-y-16 lg:space-y-24">
			{site.houseTypes.types.map((type, index) => (
				<div class:list={['flex flex-col gap-8 lg:gap-12 items-start', index % 2 === 1 ? 'lg:flex-row-reverse' : 'lg:flex-row']}>
					<div class="flex-1 w-full lg:w-auto">
						<h3 class="text-3xl lg:text-4xl font-bold text-[#2D2926] mb-2">
							{type.name}
						</h3>
						<p class="text-base text-[#2D2926]/70 mb-4">
							{type.area === 'Площа уточнюється' ? type.area : `Площа будинку - ${type.area}`}
						</p>
						<p class="text-base lg:text-lg text-[#2D2926]/80 mb-6 leading-relaxed max-w-2xl">
							{type.description}
						</p>
						<a 
							href="#contact"
							class="inline-flex items-center gap-2 bg-[#1B4332] hover:bg-[#0F2E1F] text-white px-6 py-3 rounded-lg transition-colors text-sm font-semibold shadow-sm"
						>
							ДЕТАЛЬНО
							<span class="w-4 h-4 bg-white/30 rounded flex items-center justify-center shrink-0">
								<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
								</svg>
							</span>
						</a>
					</div>
					<div
						class:list={[
							'flex-1 w-full h-[400px] lg:h-[500px] rounded-lg overflow-hidden',
							type.image?.fit === 'contain' ? 'bg-[#F5F5F0]' : 'bg-[#E8E8E0]',
						]}
					>
						{type.image && (
							<img 
								src={withBase(type.image.src)} 
								alt={type.image.alt}
								class:list={[
									'block w-full h-full',
									type.image.fit === 'contain'
										? 'object-contain object-center'
										: type.image.objectPosition === 'center'
											? 'object-cover object-center'
											: 'object-cover object-[center_42%]',
								]}
								loading="lazy"
								decoding="async"
							/>
						)}
					</div>
				</div>
			))}
		</div>
	</div>
</section>
