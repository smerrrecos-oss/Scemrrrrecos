---
import { site } from '../../data/site';
---

<section class="bg-[#1B4332]">
	<div class="max-w-[1440px] mx-auto px-6 lg:px-12 py-12 lg:py-16">
		<!-- Service Cards -->
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6 mb-16 lg:mb-20">
			{site.services.items.map((service) => (
				<div class="bg-[#1B4332] border border-white/10 p-6 lg:p-8 rounded-lg hover:border-white/20 transition-colors">
					<!-- Icon placeholder -->
					<div class="w-10 h-10 lg:w-12 lg:h-12 mb-4 text-white">
						<span class="text-2xl lg:text-3xl">●</span>
					</div>
					<h3 class="text-lg lg:text-xl font-bold text-white mb-3">
						{service.title}
					</h3>
					<p class="text-white/80 text-sm lg:text-base leading-relaxed">
						{service.description}
					</p>
				</div>
			))}
		</div>
	</div>
	
	<!-- Bottom Section with Image Background -->
	<div class="relative min-h-[500px] lg:min-h-[600px] bg-gradient-to-b from-[#1B4332] to-[#0F2E1F]">
		<div class="absolute inset-0 bg-[#E8E8E0]/5">
			<!-- Image background will be added here -->
		</div>
		<div class="relative max-w-[1440px] mx-auto px-6 lg:px-12 py-16 lg:py-24">
			<div class="max-w-4xl">
				<h2 class="text-3xl lg:text-5xl xl:text-6xl font-bold text-white mb-6 lg:mb-8 leading-tight">
					{site.services.title}
				</h2>
				<p class="text-white/80 text-base lg:text-lg mb-8 lg:mb-12 leading-relaxed max-w-2xl">
					{site.services.subtitle}
				</p>
				<a 
					href="#contacts"
					class="inline-flex items-center gap-2 bg-white text-[#1B4332] px-8 py-4 rounded-lg hover:bg-white/90 transition-colors text-sm font-medium uppercase"
				>
					КОНСУЛЬТАЦІЯ
					<span class="w-5 h-5 bg-[#1B4332]/10 rounded flex items-center justify-center">
						<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
						</svg>
					</span>
				</a>
			</div>
		</div>
	</div>
</section>
