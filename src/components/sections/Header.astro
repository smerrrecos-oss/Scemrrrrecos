---
import { site } from '../../data/site';
---

<header class="bg-[#F5F5F0] sticky top-0 z-50 border-b border-[#2D2926]/10">
	<div class="max-w-[1440px] mx-auto px-6 lg:px-12 py-4 lg:py-6">
		<div class="flex items-center justify-between gap-4 lg:gap-8">
			<!-- Logo -->
			<a href="#home" class="text-xl lg:text-2xl font-bold text-[#2D2926] uppercase tracking-tight">
				{site.title}
			</a>
			
			<!-- Navigation (Desktop) -->
			<nav class="hidden lg:flex items-center gap-8">
				{site.nav.map((item) => (
					<a 
						href={item.href} 
						class="text-[#2D2926] hover:text-[#2D2926]/70 transition-colors text-sm font-medium"
					>
						{item.label}
					</a>
				))}
			</nav>
			
			<!-- Phone (Desktop) -->
			<a 
				href={`tel:${site.phone.replace(/\s/g, '')}`}
				class="hidden lg:block text-[#2D2926] text-sm font-medium hover:text-[#2D2926]/70 transition-colors"
			>
				{site.phone}
			</a>
			
			<!-- Mobile Menu Button -->
			<button 
				id="mobile-menu-toggle"
				class="lg:hidden w-8 h-8 flex flex-col justify-center gap-1.5 text-[#2D2926]"
				aria-label="Toggle menu"
			>
				<span class="w-full h-0.5 bg-current transition-all"></span>
				<span class="w-full h-0.5 bg-current transition-all"></span>
				<span class="w-full h-0.5 bg-current transition-all"></span>
			</button>
			
			<!-- CTA Button (Desktop) -->
			<a 
				href="#contact" 
				class="hidden lg:flex bg-[#2D2926] text-white px-6 py-3 rounded-lg hover:bg-[#2D2926]/90 transition-colors items-center gap-2 text-sm font-medium uppercase"
			>
				КОНТАКТИ
				<span class="w-5 h-5 bg-white/20 rounded flex items-center justify-center">
					<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
					</svg>
				</span>
			</a>
		</div>
		
		<!-- Mobile Menu -->
		<div id="mobile-menu" class="hidden lg:hidden mt-6 pb-4 border-t border-[#2D2926]/10 pt-4">
			<nav class="flex flex-col gap-4 mb-4">
				{site.nav.map((item) => (
					<a 
						href={item.href} 
						class="text-[#2D2926] hover:text-[#2D2926]/70 transition-colors text-sm font-medium py-2"
					>
						{item.label}
					</a>
				))}
			</nav>
			<a 
				href={`tel:${site.phone.replace(/\s/g, '')}`}
				class="text-[#2D2926] text-sm font-medium hover:text-[#2D2926]/70 transition-colors mb-4 block"
			>
				{site.phone}
			</a>
			<a 
				href="#contact" 
				class="inline-flex bg-[#2D2926] text-white px-6 py-3 rounded-lg hover:bg-[#2D2926]/90 transition-colors items-center gap-2 text-sm font-medium uppercase"
			>
				КОНТАКТИ
				<span class="w-5 h-5 bg-white/20 rounded flex items-center justify-center">
					<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
					</svg>
				</span>
			</a>
		</div>
	</div>
</header>

<script>
	const toggle = document.getElementById('mobile-menu-toggle');
	const menu = document.getElementById('mobile-menu');
	const spans = toggle?.querySelectorAll('span');
	
	toggle?.addEventListener('click', () => {
		menu?.classList.toggle('hidden');
		if (spans) {
			spans.forEach((span, i) => {
				if (menu?.classList.contains('hidden')) {
					span.style.transform = '';
				} else {
					if (i === 0) span.style.transform = 'rotate(45deg) translateY(8px)';
					if (i === 1) span.style.opacity = '0';
					if (i === 2) span.style.transform = 'rotate(-45deg) translateY(-8px)';
				}
			});
		}
	});
</script>
