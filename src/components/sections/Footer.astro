---
import { site } from '../../data/site';
---

<footer id="contacts" class="bg-[#1B4332] text-white py-12 lg:py-16">
	<div class="max-w-[1440px] mx-auto px-6 lg:px-12">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
			<!-- Logo -->
			<div>
				<h3 class="text-2xl font-bold uppercase mb-6">{site.title}</h3>
			</div>
			
			<!-- Navigation -->
			<div>
				<h4 class="font-semibold mb-4 text-sm uppercase tracking-wide">Навігація</h4>
				<nav class="flex flex-col gap-3">
					{site.footer.nav.map((item) => (
						<a 
							href={item.href} 
							class="text-white/80 hover:text-white transition-colors text-sm"
						>
							{item.label}
						</a>
					))}
				</nav>
			</div>
			
			<!-- Contact Info -->
			<div>
				<h4 class="font-semibold mb-4 text-sm uppercase tracking-wide">Контакти</h4>
				<div class="flex flex-col gap-3 text-sm">
					<div>
						<span class="font-medium">Телефон:</span>
						<a href={`tel:${site.phone.replace(/\s/g, '')}`} class="ml-2 text-white/80 hover:text-white transition-colors">
							{site.phone}
						</a>
					</div>
					<div>
						<span class="font-medium">Адресса:</span>
						<span class="ml-2 text-white/80">{site.address}</span>
					</div>
					<div>
						<span class="font-medium">Пошта:</span>
						<a href={`mailto:${site.email}`} class="ml-2 text-white/80 hover:text-white transition-colors">
							{site.email}
						</a>
					</div>
				</div>
			</div>
			
			<!-- Social & Legal -->
			<div>
				<h4 class="font-semibold mb-4 text-sm uppercase tracking-wide">Соціальні мережі</h4>
				<div class="flex flex-col gap-3">
					{site.footer.social.map((social) => (
						<a 
							href={social.href} 
							target="_blank"
							rel="noopener noreferrer"
							class="text-white/80 hover:text-white transition-colors text-sm"
						>
							{social.label}
						</a>
					))}
					<a 
						href={site.footer.policy.href}
						class="text-white/80 hover:text-white transition-colors text-sm mt-4 pt-4 border-t border-white/10"
					>
						{site.footer.policy.label}
					</a>
				</div>
			</div>
		</div>
	</div>
</footer>
